{
  "extends": "solhint:recommended",
  "rules": {
    "compiler-version": [
      "error",
      "0.8.34"
    ],
    "func-visibility": [
      "error",
      {
        "ignoreConstructors": true
      }
    ],
    "no-unused-vars": "error",
    "max-line-length": [
      "error",
      100
    ],
    "reason-string": "off",
    "no-global-import": "error",
    "ordering": "warn",
    "gas-custom-errors": "error",
    "gas-indexed-events": "off",
    "gas-strict-inequalities": "off"
  }
}