# --- Adresse du module de cycle de vie -----------------------------------
# UNE SEULE adresse est necessaire : LifecycleModule expose ROLES, PASSPORTS
# et LOTS en public immutable, le front derive les trois autres au demarrage.
VITE_LIFECYCLE_ADDRESS=

# --- Reseau ---------------------------------------------------------------
# Sepolia = 11155111, Holesky = 17000, mainnet = 1
VITE_CHAIN_ID=11155111
VITE_CHAIN_NAME=Sepolia
VITE_CURRENCY_SYMBOL=ETH
VITE_EXPLORER_URL=https://sepolia.etherscan.io


# --- Wallet ---------------------------------------------------------------
# REQUIS : sans lui la modale de connexion ne s'ouvre pas.
# Project ID gratuit sur https://cloud.reown.com
VITE_REOWN_PROJECT_ID=
VITE_ACTOR_REGISTRY_ADDRESS=
